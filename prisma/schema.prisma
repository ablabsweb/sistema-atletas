generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Modalidade {
  FUTEBOL_CAMPO
  FUTSAL
  BEACH_SOCCER
  VOLEI
  SOCIETY
  BASQUETE
}

model Equipe {
  id         String      @id @default(cuid())
  nome       String
  escudoUrl  String?
  modalidade Modalidade
  categorias Categoria[]
  atletas    Atleta[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum StatusAtleta {
  ATIVO
  PENDURADO
  SUSPENSO
  LESIONADO
  INATIVO
}

model Categoria {
  id        String   @id @default(cuid())
  nome      String   // ex: Sub-15, Sub-17, Livre
  equipeId  String
  equipe    Equipe   @relation(fields: [equipeId], references: [id])
  atletas   Atleta[]
  createdAt DateTime @default(now())

  @@unique([equipeId, nome])
}

model Atleta {
  id          String       @id @default(cuid())
  nome        String
  fotoUrl     String?
  posicao     String
  dataNasc    DateTime
  altura      Float?
  peso        Float?
  numero      Int?
  status      StatusAtleta @default(ATIVO)
  equipeId    String
  equipe      Equipe       @relation(fields: [equipeId], references: [id])
  categoriaId String
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}