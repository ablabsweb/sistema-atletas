generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Modalidade {
  FUTEBOL_CAMPO
  FUTSAL
  BEACH_SOCCER
  VOLEI
  SOCIETY
  BASQUETE
}

model Equipe {
  id         String      @id @default(cuid())
  nome       String
  escudoUrl  String?
  modalidade Modalidade
  categorias Categoria[]
  atletas    Atleta[]
  competicoes Competicao[]
  jogos      Jogo[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum StatusAtleta {
  ATIVO
  PENDURADO
  SUSPENSO
  LESIONADO
  INATIVO
}

model Categoria {
  id          String       @id @default(cuid())
  nome        String
  equipeId    String
  equipe      Equipe       @relation(fields: [equipeId], references: [id])
  atletas     Atleta[]
  competicoes Competicao[]
  jogos       Jogo[]
  createdAt   DateTime     @default(now())

  @@unique([equipeId, nome])
}

model Atleta {
  id          String       @id @default(cuid())
  nome        String
  fotoUrl     String?
  posicao     String
  dataNasc    DateTime
  altura      Float?
  peso        Float?
  numero      Int?
  status      StatusAtleta @default(ATIVO)
  equipeId    String
  equipe      Equipe       @relation(fields: [equipeId], references: [id])
  categoriaId String
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  eventos     EventoJogo[]
  escalacoes  Escalacao[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum StatusJogo {
  AGENDADO
  EM_ANDAMENTO
  FINALIZADO
  ADIADO
}

enum TipoEvento {
  GOL
  CARTAO_AMARELO
  CARTAO_VERMELHO
  SUBSTITUICAO
}

model Competicao {
  id          String      @id @default(cuid())
  nome        String
  equipeId    String
  equipe      Equipe      @relation(fields: [equipeId], references: [id])
  categoriaId String
  categoria   Categoria   @relation(fields: [categoriaId], references: [id])
  inicio      DateTime?
  fim         DateTime?
  jogos       Jogo[]
  createdAt   DateTime    @default(now())
}

model Jogo {
  id             String       @id @default(cuid())
  data           DateTime
  status         StatusJogo   @default(AGENDADO)
  competicaoId   String
  competicao     Competicao   @relation(fields: [competicaoId], references: [id])
  equipeId       String
  equipe         Equipe       @relation(fields: [equipeId], references: [id])
  categoriaId    String
  categoria      Categoria    @relation(fields: [categoriaId], references: [id])
  adversario     String
  mandante       Boolean      @default(true)
  golsNos        Int?
  golsAdversario Int?
  eventos        EventoJogo[]
  escalacoes     Escalacao[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Escalacao {
  id             String @id @default(cuid())
  jogoId         String
  jogo           Jogo   @relation(fields: [jogoId], references: [id])
  atletaId       String
  atleta         Atleta @relation(fields: [atletaId], references: [id])
  titular        Boolean @default(true)
  minutosJogados Int     @default(0)

  @@unique([jogoId, atletaId])
}

model EventoJogo {
  id       String     @id @default(cuid())
  jogoId   String
  jogo     Jogo       @relation(fields: [jogoId], references: [id])
  atletaId String
  atleta   Atleta     @relation(fields: [atletaId], references: [id])
  tipo     TipoEvento
  minuto   Int
}